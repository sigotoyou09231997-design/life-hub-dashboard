# Gmail AI自動返信機能に必要な環境変数。
# .env としてコピーし、値を埋めてください(.env はコミットされません)。
# Netlify本番環境では、これらをNetlifyサイトの環境変数として設定してください。

# --- フロントエンドに公開される値(Vite ビルド時にバンドルへ埋め込まれる) ---
# Google Cloud ConsoleのOAuthクライアントID(公開情報のためVITE_プレフィックスで問題ない)
VITE_GOOGLE_CLIENT_ID=

# PC/スマホ同期機能に必要(Supabaseプロジェクトの Project Settings > API から取得)。
# anon keyはRLS(Row Level Security)で保護される前提の公開情報なのでVITE_プレフィックスで問題ない。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gmailバックグラウンド通知(Web Push)用のVAPID公開鍵。web-pushのgenerateVAPIDKeys()で生成した
# publicKeyをそのまま設定する(公開鍵なのでVITE_プレフィックスで問題ない)。
VITE_VAPID_PUBLIC_KEY=

# --- Netlify Functions 専用(サーバー側のみで使用、ブラウザには一切渡らない) ---
# 上記と同じOAuthクライアントID
GOOGLE_CLIENT_ID=
# Google Cloud ConsoleのOAuthクライアントシークレット
GOOGLE_CLIENT_SECRET=
# Anthropic Consoleで発行したAPIキー(AI下書き生成に使用)
ANTHROPIC_API_KEY=

# Gmailバックグラウンド通知(netlify/functions/checkGmailAndNotify.ts)と、アプリの新バージョン
# 公開通知(netlify/functions/checkAppUpdate.ts)、どちらも2分ごとのScheduled Function用。
# SUPABASE_SERVICE_ROLE_KEYはSupabaseの Project Settings > API から取得する秘密鍵で、
# RLSを越えて全ユーザーのrefresh_tokenを読むために必要(anon keyとは別物、絶対にVITE_を付けない)。
SUPABASE_SERVICE_ROLE_KEY=
# web-pushのgenerateVAPIDKeys()で生成したprivateKey
VAPID_PRIVATE_KEY=
# Web Push仕様上必須の連絡先。"mailto:you@example.com" の形式
VAPID_SUBJECT=
