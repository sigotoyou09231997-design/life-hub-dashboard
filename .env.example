# Gmail AI自動返信機能に必要な環境変数。
# .env としてコピーし、値を埋めてください(.env はコミットされません)。
# Netlify本番環境では、これらをNetlifyサイトの環境変数として設定してください。

# --- フロントエンドに公開される値(Vite ビルド時にバンドルへ埋め込まれる) ---
# Google Cloud ConsoleのOAuthクライアントID(公開情報のためVITE_プレフィックスで問題ない)
VITE_GOOGLE_CLIENT_ID=

# --- Netlify Functions 専用(サーバー側のみで使用、ブラウザには一切渡らない) ---
# 上記と同じOAuthクライアントID
GOOGLE_CLIENT_ID=
# Google Cloud ConsoleのOAuthクライアントシークレット
GOOGLE_CLIENT_SECRET=
# Anthropic Consoleで発行したAPIキー(AI下書き生成に使用)
ANTHROPIC_API_KEY=
